digraph "Door" {
  rankdir=LR;
  labelloc="t";
  label="Door  (CENTRALIZED_DISPATCH)";
  node [shape=rectangle, style=rounded, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];

  __start [shape=point, width=0.12, label=""];
  __start -> "Closed";

  "Open";
  "Closed" [penwidth=2, color="#1a73e8"];
  "Locked";

  "Closed" -> "Locked" [label="[event instanceof examples.door.Lock]"];
  "Closed" -> "Open" [label="[!(event instanceof examples.door.Lock)]"];
  "Open" -> "Closed";
  "Locked" -> "Closed" [label="[event instanceof examples.door.Unlock]"];
  "Locked" -> "Locked" [label="[!(event instanceof examples.door.Unlock)]"];
}
