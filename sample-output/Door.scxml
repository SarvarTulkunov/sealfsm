<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="Door" initial="Closed">
  <!-- Generated by SealFSM from sealed hierarchy examples.door.Door -->
  <!-- Encoding style: CENTRALIZED; states: 3; transitions resolved/total: 5/5 -->
  <state id="Open">
    <transition target="Closed"/>
  </state>
  <state id="Closed">
    <transition cond="event instanceof Lock" target="Locked"/>
    <transition cond="!(event instanceof Lock)" target="Open"/>
  </state>
  <state id="Locked">
    <transition cond="event instanceof Unlock" target="Closed"/>
    <transition cond="!(event instanceof Unlock)" target="Locked"/>
  </state>
</scxml>
